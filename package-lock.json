{
  "name": "retroport",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "retroport",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22.0.0",
        "npm": ">=10.0.0"
      }
    },
    "apps/cli": {
      "name": "@retroport/cli",
      "version": "0.0.0"
    },
    "apps/cli/node_modules/tsx": {
      "extraneous": true
    },
    "node_modules/@retroport/cli": {
      "resolved": "apps/cli",
      "link": true
    },
    "node_modules/@retroport/compatibility": {
      "resolved": "packages/compatibility",
      "link": true
    },
    "node_modules/@retroport/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@retroport/evidence": {
      "resolved": "packages/evidence",
      "link": true
    },
    "node_modules/@retroport/schemas": {
      "resolved": "packages/schemas",
      "link": true
    },
    "packages/compatibility": {
      "name": "@retroport/compatibility",
      "version": "0.0.0"
    },
    "packages/compatibility/node_modules/yaml": {
      "extraneous": true
    },
    "packages/core": {
      "name": "@retroport/core",
      "version": "0.0.0"
    },
    "packages/evidence": {
      "name": "@retroport/evidence",
      "version": "0.0.0"
    },
    "packages/schemas": {
      "name": "@retroport/schemas",
      "version": "0.0.0"
    },
    "packages/schemas/node_modules/zod": {
      "extraneous": true
    }
  }
}
