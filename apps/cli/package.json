{
  "name": "@retroport/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": { "retroport": "./src/index.ts" },
  "scripts": {
    "acceptance": "node --import tsx src/index.ts acceptance",
    "doctor": "node --import tsx src/index.ts doctor",
    "inspect": "node --import tsx src/index.ts inspect",
    "inspect-adf": "node --import tsx src/index.ts inspect-adf",
    "inspect-adf-set": "node --import tsx src/index.ts inspect-adf-set",
    "write-adf-manifest": "node --import tsx src/index.ts write-adf-manifest",
    "plan-adf-extraction": "node --import tsx src/index.ts plan-adf-extraction",
    "preflight": "node --import tsx src/index.ts preflight",
    "reconstruct": "node --import tsx src/index.ts reconstruct",
    "generate": "node --import tsx src/index.ts generate",
    "grade": "node --import tsx src/index.ts grade",
    "experiment": "node --import tsx src/index.ts experiment",
    "phase0": "node --import tsx src/index.ts phase0",
    "phase0-captured": "node --import tsx src/index.ts phase0-captured",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@retroport/compatibility": "*",
    "@retroport/persistence": "*",
    "@retroport/phase0-pipeline": "*",
    "@retroport/reconstruction": "*",
    "@retroport/runtime-amiberry": "*",
    "@retroport/schemas": "*",
    "@retroport/source-amiga-adf": "*",
    "@retroport/source-amiga-hunk": "*",
    "@retroport/static-analysis": "*",
    "@retroport/target-typescript": "*",
    "@retroport/verification": "*",
    "tsx": "4.20.3"
  }
}
